    setLinkHandle('');
  };

  const handleDisconnect = async (accountId: string, platform: string) => {
    if (!workspace?.id) return;
    if (!confirm(`Disconnect your ${platform} account?`)) return;
    try {
      await updateAccount(workspace?.id, accountId, {
        connected: false,
        handle: '',
