      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString(),
    });

    await set(newRef, data);

    try {
      await createContact(lead.workspace_id || 'default', {
        name: lead.name,
        email: lead.email,
        workspace_id: lead.workspace_id || '',
        phone: lead.phone || '',
