                          return (
                            <div key={activity.id} className="flex items-start gap-3 p-3 hover:bg-muted/30 transition-colors">
                              <div className={cn('w-8 h-8 rounded-full flex items-center justify-center shrink-0 opacity-60', cfg.color)}>
                                <Icon size={14} />
