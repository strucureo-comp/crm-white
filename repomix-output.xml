                </SelectContent>
              </Select>
            </div>
            <div>
              <Label htmlFor="client_id">Client ID</Label>
              <Input id="client_id" value={form.client_id} onChange={(e) => set('client_id', e.target.value)} placeholder="client-id" />
            </div>
            <div className="col-span-2">
              <Label htmlFor="notes">Notes</Label>
              <textarea
