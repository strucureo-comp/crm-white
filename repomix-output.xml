        </div>
      </div>

      <div className="grid grid-cols-2 gap-4">
        <div className="space-y-2">
          <Label>{docType === 'quote' ? 'Issue Date' : 'Invoice Date'}</Label>
          <Input
            type="date"
            value={meta.issue_date}
            onChange={(e) => onMetaChange({ issue_date: e.target.value })}
          />
        </div>
        {docType === 'quote' ? (
          <div className="space-y-2">
